generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Author {
  id          Int     @id @default(autoincrement())
  name        String @unique
  website     String?
  group       String?
  profile     String?
  masterpiece String?
  posts       Post[]
  authorTwitter String?
  groupTwitter String?

  @@index([name])
  @@map("Author")
}

model Post {
  id                  Int             @id @default(autoincrement())
  title               String
  content             String?
  author_id           Int
  man                 Int?
  woman               Int?
  others              Int?
  totalNumber         Int?
  playtime            Int?
  synopsis            String?
  image_url           String?
  amazon_text_url     String?
  amazon_img_url      String?
  amazon_img_text_url String?
  link_to_plot        String?
  website1            String?
  website2            String?
  website3            String?
  ISBN_13             String?
  buy_link            String?
  comments      ParentComment[]
  access              Access[]
  averageRating Float?
  ratings   Rating[]
  author              Author          @relation(fields: [author_id], references: [id])
  kangeki_url         String?
  aiDescription       String?         @map("ai_description")
  categories          Category[]      @relation("PostCategory")
  theaterGroups       PostTheaterGroup[]
  awards              PostAward[]
  announcements       Announcement[]
  favorites           Favorite[]
  userSynopses        UserSynopsis[]
  venuePerformances   VenuePerformance[]

  @@index([title])
  @@index([synopsis])
  @@index([man])
  @@index([woman])
  @@index([totalNumber])
  @@index([playtime])
  @@index([averageRating])
  @@index([author_id])
  @@index([man, woman, totalNumber])
  @@index([playtime, averageRating])
  @@map("Post")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[] @relation("PostCategory")
  image_url String?
  contentMarkdown String?

  @@map("Category")
}

model News {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  url      String?
  category String
  title    String

  @@map("News")
}

model Access {
  id        Int      @id @default(autoincrement())
  ipAddress String
  postId    Int
  date      DateTime @db.Date
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([ipAddress, postId, date])
  @@map("Access")
}

model ParentComment {
  id          Int            @id @default(autoincrement())
  content     String
  deleted     Boolean        @default(false)
  post_id     Int
  author      String         @default("名無しさん")
  date        DateTime       @default(now())
  likes       Int            @default(0)
  commentType String?
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  children    ChildComment[]
  post        Post           @relation(fields: [post_id], references: [id])

  @@index([userId])
  @@map("ParentComment")
}

model ChildComment {
  id              Int           @id @default(autoincrement())
  content         String
  deleted         Boolean       @default(false)
  parentCommentId Int
  author          String        @default("名無しさん")
  date            DateTime      @default(now())
  likes           Int           @default(0)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentComment   ParentComment @relation(fields: [parentCommentId], references: [id])

  @@index([userId])
  @@map("ChildComment")
}

model Rating {
  id        Int      @id @default(autoincrement())
  ipAddress String
  star      Float
  createdAt DateTime @default(now())
  postId    Int
  Post      Post     @relation(fields: [postId], references: [id])

  @@map("Rating")
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String?
  content     String
  tags        String[]
  language    String   @default("ja")
  ogImageUrl  String?
  publishedAt DateTime
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([language])
  @@map("BlogPost")
}

// === 大学演劇 ===

enum UniversityType {
  NATIONAL    // 国立
  PUBLIC      // 公立
  PRIVATE     // 私立
}

enum Region {
  HOKKAIDO
  TOHOKU
  KANTO
  CHUBU
  KANSAI
  CHUGOKU_SHIKOKU
  KYUSHU_OKINAWA
}

enum TheaterGroupType {
  STUDENT       // 学生劇団
  INTERCOLLEGE  // インカレ
  ACADEMIC      // 大学学科
  AMATEUR       // アマチュア・社会人
  PROFESSIONAL  // プロ
  YOUTH         // ユース
}

model University {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  slug            String           @unique
  universityType  UniversityType
  prefecture      String
  region          Region
  website         String?
  theaterGroups   TheaterGroupUniversity[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([region])
  @@index([prefecture])
  @@index([universityType])
  @@map("University")
}

model TheaterGroup {
  id            Int                      @id @default(autoincrement())
  name          String
  slug          String                   @unique
  groupType     TheaterGroupType         @default(STUDENT)
  description   String?
  memberCount   Int?
  foundedYear   Int?
  prefecture    String?
  region        Region?
  website       String?
  twitter       String?
  instagram     String?
  corich        String?
  otherLinks    String[]
  isActive      Boolean                  @default(true)
  blogPostSlug  String?
  universities  TheaterGroupUniversity[]
  posts              PostTheaterGroup[]
  recruitments       Recruitment[]
  venuePerformances  VenuePerformance[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([groupType])
  @@index([isActive])
  @@index([prefecture])
  @@index([region])
  @@map("TheaterGroup")
}

model Venue {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  venueType   String    @default("small") // small, medium, large, outdoor, other
  capacity    Int?
  prefecture  String
  address     String?
  website     String?
  twitter     String?
  description String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  announcements       Announcement[]
  performances        PostTheaterGroup[]
  venuePerformances   VenuePerformance[]

  @@index([prefecture])
  @@index([venueType])
  @@index([slug])
  @@map("Venue")
}

model VenuePerformance {
  id              Int          @id @default(autoincrement())
  venueId         Int
  title           String       // 作品名・公演名
  artistName      String?      // 作家名・演出家名・団体名
  performanceType String       @default("play") // play, reading, festival, workshop, other
  year            Int?         // 上演年
  month           Int?         // 上演月
  description     String?      // 補足情報（演劇祭名、企画名など）
  sourceUrl       String?      // エビデンスURL
  postId          Int?         // サイト内作品への紐付け（任意）
  theaterGroupId  Int?         // 劇団への紐付け（任意）
  post            Post?        @relation(fields: [postId], references: [id])
  theaterGroup    TheaterGroup? @relation(fields: [theaterGroupId], references: [id])
  venue           Venue        @relation(fields: [venueId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([venueId])
  @@index([postId])
  @@index([theaterGroupId])
  @@index([year])
  @@map("VenuePerformance")
}

model TheaterGroupUniversity {
  id              Int          @id @default(autoincrement())
  theaterGroupId  Int
  universityId    Int
  campus          String?
  theaterGroup    TheaterGroup @relation(fields: [theaterGroupId], references: [id])
  university      University   @relation(fields: [universityId], references: [id])

  @@unique([theaterGroupId, universityId])
  @@index([theaterGroupId])
  @@index([universityId])
  @@map("TheaterGroupUniversity")
}

// === 演劇ニュース収集（内部用ネタ帳） ===

model TheaterNewsItem {
  id          Int      @id @default(autoincrement())
  source      String   // RSSソース名 (natalie, broadwayworld, etc.)
  sourceUrl   String   @unique // 元記事URL（重複防止）
  title       String
  summary     String?  // 記事の要約・description
  language    String   @default("ja") // ja or en
  category    String?  // カテゴリタグ
  publishedAt DateTime // 元記事の公開日時
  fetchedAt   DateTime @default(now()) // 取得日時
  used        Boolean  @default(false) // 記事に使用済みか
  usedInSlug  String?  // 使用した記事のslug

  @@index([publishedAt(sort: Desc)])
  @@index([used])
  @@index([source])
  @@index([language])
  @@map("TheaterNewsItem")
}

model Announcement {
  id               Int      @id @default(autoincrement())
  title            String
  content          String
  performanceDate  DateTime?
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  venueId          Int?
  venueRef         Venue?   @relation(fields: [venueId], references: [id])
  ticketPrice      String?
  contactInfo      String?
  authorName       String   @default("名無しさん")
  ipAddress        String?
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  views            Int      @default(0)
  postId           Int?
  post             Post?    @relation(fields: [postId], references: [id])
  theaterGroupName String?
  scriptTitle      String?
  images           String[]

  @@index([createdAt(sort: Desc)])
  @@index([performanceDate])
  @@index([startDate])
  @@index([views(sort: Desc)])
  @@index([postId])
  @@index([userId])
  @@map("Announcement")
}

model PostTheaterGroup {
  id              Int          @id @default(autoincrement())
  postId          Int
  theaterGroupId  Int
  sourceUrl       String?      // 上演の根拠となるURL（公式サイト・SNS等）
  sourceType      String?      // 根拠の種類: official, twitter, instagram, corich, other
  performanceYear Int?         // 上演年
  venueId         Int?         // 上演劇場
  post            Post         @relation(fields: [postId], references: [id])
  theaterGroup    TheaterGroup @relation(fields: [theaterGroupId], references: [id])
  venue           Venue?       @relation(fields: [venueId], references: [id])

  @@unique([postId, theaterGroupId])
  @@index([postId])
  @@index([theaterGroupId])
  @@map("PostTheaterGroup")
}

model PostAward {
  id         Int    @id @default(autoincrement())
  postId     Int
  awardName  String
  awardYear  Int
  awardType  String @default("受賞")
  post       Post   @relation(fields: [postId], references: [id])

  @@unique([postId, awardName, awardYear])
  @@index([postId])
  @@index([awardName])
  @@map("PostAward")
}

// ============================================
// NextAuth.js 認証モデル
// ============================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  displayName   String?
  bio           String?
  avatarUrl     String?
  groupName     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  parentComments    ParentComment[]
  childComments     ChildComment[]
  favorites         Favorite[]
  reports           Report[]
  searchHistories   SearchHistory[]
  announcements     Announcement[]
  recruitments      Recruitment[]
  applications      Application[]
  interests         Interest[]
  sentMessages      Message[]       @relation("SentMessages")
  receivedMessages  Message[]       @relation("ReceivedMessages")
  userSynopses      UserSynopsis[]

  @@index([email])
  @@map("User")
}

model UserSynopsis {
  id        Int      @id @default(autoincrement())
  content   String
  status    String   @default("pending") // pending, approved, rejected
  postId    Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@map("UserSynopsis")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("Favorite")
}

// ============================================
// 通報・検索履歴
// ============================================

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id          Int          @id @default(autoincrement())
  reporterId  String
  reason      String
  details     String?
  targetType  String       // "comment" | "announcement" | "user"
  targetId    String       // 対象のID（コメントID, ユーザーID等）
  targetUrl   String?      // 通報対象のページURL
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@map("Report")
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userId     String
  query      Json
  resultCount Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("SearchHistory")
}

// ============================================
// 劇団員募集
// ============================================

enum RecruitmentStatus {
  ACTIVE
  CLOSED
  PAUSED
}

enum ExperienceLevel {
  ANY
  BEGINNER
  EXPERIENCED
}

model Recruitment {
  id                  String            @id @default(cuid())
  title               String
  description         String
  postedBy            String
  poster              User              @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  theaterGroupId      Int?
  theaterGroup        TheaterGroup?     @relation(fields: [theaterGroupId], references: [id])
  theaterGroupName    String?
  recruitmentType     String?           // "member" | "cast" | "staff"
  rolesWanted         String[]
  genre               String?           // 演劇, ミュージカル, 朗読劇 等
  vibe                String[]          // カジュアル, 本格派, 初心者歓迎 等
  groupType           String?           // 学生劇団, 社会人劇団, プロ 等
  experienceLevel     ExperienceLevel   @default(ANY)
  genderRequirement   String?
  ageRangeMin         Int?
  ageRangeMax         Int?
  feeStructure        String?
  prefecture          String?
  rehearsalFrequency  String?
  rehearsalLocation   String?
  venue               String?
  startDate           DateTime?
  endDate             DateTime?
  images              String[]
  contactMethod       String?
  status              RecruitmentStatus @default(ACTIVE)
  views               Int               @default(0)
  publishedAt         DateTime          @default(now())
  expiresAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  applications        Application[]
  interests           Interest[]

  @@index([status, publishedAt])
  @@index([postedBy])
  @@index([theaterGroupId])
  @@map("Recruitment")
}

model Interest {
  id             String      @id @default(cuid())
  recruitmentId  String
  recruitment    Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([recruitmentId, userId])
  @@index([recruitmentId])
  @@index([userId])
  @@map("Interest")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id             String            @id @default(cuid())
  recruitmentId  String
  recruitment    Recruitment       @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  message        String
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([recruitmentId, applicantId])
  @@index([applicantId])
  @@index([recruitmentId])
  @@map("Application")
}

// ============================================
// メッセージ
// ============================================

model Conversation {
  id           String    @id @default(cuid())
  participant1 String
  participant2 String
  lastMessage  String?
  lastAt       DateTime  @default(now())
  messages     Message[]
  createdAt    DateTime  @default(now())

  @@unique([participant1, participant2])
  @@index([participant1, lastAt])
  @@index([participant2, lastAt])
  @@map("Conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([receiverId, readAt])
  @@map("Message")
}